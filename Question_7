<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conference Schedule</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; line-height: 1.6; }
        header, main, footer { margin-bottom: 20px; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid black; padding: 8px; text-align: center; }
        th { background-color: #f2f2f2; }
        tfoot td { font-weight: bold; background-color: #f9f9f9; }
    </style>
</head>
<body>

    <!-- Header -->
    <header>
        <h1>Annual Tech Conference 2025</h1>
        <p>Conference Schedule</p>
    </header>

    <!-- Main Content -->
    <main>
        <table>
            <!-- Table Head -->
            <thead>
                <tr>
                    <th>Session</th>
                    <th>Time</th>
                    <th>Topic</th>
                    <th>Speaker</th>
                </tr>
            </thead>

            <!-- Table Body -->
            <tbody>
                <!-- Morning Session -->
                <tr>
                    <td>Morning</td>
                    <td>09:00 AM - 10:00 AM</td>
                    <td>Opening Keynote: Future of AI</td>
                    <td>Dr. A. Sharma</td>
                </tr>
                <tr>
                    <td>Morning</td>
                    <td>10:15 AM - 11:15 AM</td>
                    <td>Cloud Computing Trends</td>
                    <td>Ms. R. Gupta</td>
                </tr>
                <tr>
                    <td>Morning</td>
                    <td>11:30 AM - 12:30 PM</td>
                    <td>Cybersecurity Best Practices</td>
                    <td>Mr. V. Mehta</td>
                </tr>

                <!-- Afternoon Session -->
                <tr>
                    <td>Afternoon</td>
                    <td>01:30 PM - 02:30 PM</td>
                    <td>Data Science Workshop</td>
                    <td>Dr. S. Verma</td>
                </tr>
                <tr>
                    <td>Afternoon</td>
                    <td>02:45 PM - 03:45 PM</td>
                    <td>Blockchain Applications</td>
                    <td>Ms. L. Iyer</td>
                </tr>

                <!-- Evening Session -->
                <tr>
                    <td>Evening</td>
                    <td>04:00 PM - 05:00 PM</td>
                    <td>Panel Discussion: Emerging Tech</td>
                    <td>Multiple Speakers</td>
                </tr>
                <tr>
                    <td>Evening</td>
                    <td>05:15 PM - 06:00 PM</td>
                    <td>Closing Remarks</td>
                    <td>Dr. A. Sharma</td>
                </tr>
            </tbody>

            <!-- Table Footer -->
            <tfoot>
                <tr>
                    <td colspan="4">All sessions held in Conference Hall A</td>
                </tr>
            </tfoot>
        </table>
    </main>

    <!-- Footer -->
    <footer>
        <p>Contact: conference@techconf.com | Phone: +91-XXXXXXXXXX</p>
    </footer>

</body>
</html>
